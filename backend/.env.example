# Copy to backend/.env and fill in. Never commit the real .env.
# ---- core ----
# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
EDUAI_JWT_SECRET=
EDUAI_JWT_TTL_MIN=480
EDUAI_DB_PATH=data/eduai.sqlite3
EDUAI_CORS_ORIGINS=http://localhost:5173
# Demo accounts (password 123456) for local testing only. Set to false for any real use.
EDUAI_SEED_DEMO=true
# Students may self-register (email must start with "siswa"); staff accounts are created by Admin.
EDUAI_ALLOW_SELF_REGISTER=true

# ---- AI ----
EDUAI_AI_ENABLED=true
# Defaults to ../ai/eduai-ai/config.yaml
EDUAI_AI_CONFIG=
# How many frames may be analysed at the same time (CPU threads). Not a capacity claim.
EDUAI_AI_MAX_CONCURRENT=2
# browser = frames uploaded by the student's browser (works without OpenVidu)
# livekit = hidden AI worker subscribes to the OpenVidu room (needs LIVEKIT_* and EDUAI_AI_SERVICE_KEY)
EDUAI_ANALYSIS_SOURCE=browser
EDUAI_UPLOAD_FPS=2
EDUAI_FRAME_MAX_BYTES=400000
# Indication grouping: 0 = ONE consolidated case per student and indicator for the whole exam (one
# supervisor notification, every occurrence kept inside it). A number > 0 splits a case when the gap
# between repeats is longer than that many seconds. Display/review grouping only; detection unchanged.
EDUAI_CASE_GAP_S=0
# Time zone of exam dates/start times (for the summary 10 minutes before the end). Empty = the server's
# local time. Example: Asia/Jakarta (on Windows this needs: pip install tzdata).
EDUAI_TIMEZONE=
# Optional speech-sound analysis (indicator OTHER_VOICE). YAMNet runs in the student's browser; only
# three scores (speech/whisper/music) are sent, never audio. Needs the student's separate consent and
# ai/eduai-ai/models/yamnet.tflite. Browser frame path only. Set false to switch it off completely.
EDUAI_AUDIO_ANALYSIS=true
# Shared secret for the AI worker -> backend calls (X-AI-Service-Key). Long random string.
EDUAI_AI_SERVICE_KEY=
# URL the AI worker uses to reach this backend
EDUAI_BACKEND_URL=http://localhost:8000

# ---- evidence (JPEG snapshots around an indication; no full video, no audio) ----
EDUAI_EVIDENCE_DIR=data/evidence
EDUAI_EVIDENCE_RETENTION_HOURS=24
# Evidence of a session whose report is not final is held until finalisation, at most this many days
# after the session ended (the earlier of "Selesai" and the scheduled end).
EDUAI_EVIDENCE_HOLD_DAYS=7
# Finalising copies one image per event; each copy is deleted this many hours after finalisation.
EDUAI_REPORT_FRAMES_DIR=data/report-frames
EDUAI_REPORT_FRAME_RETENTION_HOURS=24
# Optional encryption at rest (Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDUAI_EVIDENCE_KEY=

# ---- Jitsi Meet (Rapat Video and the "Jitsi" analysis source) ----
# No server is built in: empty = Rapat Video is off and "Mulai AI" refuses the Jitsi source.
# Example for development: EDUAI_JITSI_DOMAIN=alpha.jitsi.net
# That is a public TEST server run by a third party: video passes through it and anyone who knows a
# room name can join. Use your own Jitsi server for real exams.
EDUAI_JITSI_DOMAIN=
# Who runs that server, shown to students on the consent page. Set "school" only if the school really
# runs it; empty or anything else tells students it is a third-party server.
EDUAI_JITSI_OPERATOR=
# Optional; defaults are conference.<domain> and wss://<domain>/xmpp-websocket
EDUAI_JITSI_MUC=
EDUAI_JITSI_SERVICE_URL=

# ---- letterhead of the PDF report (empty = placeholder from the template, filled in by hand) ----
EDUAI_SCHOOL_NAME=
EDUAI_SCHOOL_ADDRESS=
EDUAI_SCHOOL_PHONE=
EDUAI_SCHOOL_EMAIL=
EDUAI_SCHOOL_CITY=

# ---- OpenVidu 3 (LiveKit protocol) ----
# Local OpenVidu deployment defaults: ws://localhost:7880, key "devkey", secret "secret".
# The secret stays on the backend; browsers only receive short-lived room tokens.
LIVEKIT_URL=
# URL the browser should use (defaults to LIVEKIT_URL), e.g. ws://192.168.1.10:7880 for LAN testing
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
