# EduAI development Jitsi server: official docker-jitsi-meet, release stable-11248-2
# (docker-compose.yml in this folder is the unmodified upstream file of that release).
# Create .env from this file with:  python dev/jitsi/make-env.py   (fills the passwords and the JWT secret)
# For development on one laptop only. Not a server "dikelola sekolah".

CONFIG=./.jitsi-cfg
TZ=Asia/Jakarta
# 8000 is taken by the EduAI backend, so the plain-HTTP port moves to 8180.
HTTP_PORT=8180
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Media (video) goes to UDP 10000 on this address: this laptop's LAN IP (see ipconfig), also for the same laptop.
# Not 127.0.0.1: Chrome ignores loopback candidates, so people connect but no video flows.
# Other devices on the LAN: allow UDP 10000 in the firewall. (DOCKER_HOST_ADDRESS is the old, deprecated name.)
JVB_ADVERTISE_IPS=

# Only tokens signed by the EduAI backend may join: no guests, no anonymous rooms.
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=eduai
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=eduai
JWT_ACCEPTED_AUDIENCES=eduai
JWT_ALLOW_EMPTY=0

# No recording, streaming or transcription of any kind (Jibri and Jigasi are not started either).
ENABLE_RECORDING=0
ENABLE_SERVICE_RECORDING=0
ENABLE_FILE_RECORDING_SHARING=0
DISABLE_LOCAL_RECORDING=true
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_P2P=false
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0

# Internal component passwords (make-env.py fills them).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
