# Frontend settings (Vite). Copy to frontend/.env.local if you need to change them.
# Leave VITE_API_BASE_URL empty in development: requests go to /api and Vite proxies them.
VITE_API_BASE_URL=
# Where the dev proxy forwards /api (the FastAPI backend)
VITE_API_PROXY=http://localhost:8000
# No secrets here: everything in a VITE_* variable is visible in the browser.
# The Jitsi server is set on the backend (EDUAI_JITSI_DOMAIN in backend/.env), not here.
